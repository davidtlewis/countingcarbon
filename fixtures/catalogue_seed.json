              "label": "Return trip",
              "type": "boolean",
              "unit": null
            },
            {
              "name": "cabin_class",
              "label": "Class",
              "type": "choice",
              "unit": null,
              "choices": [
                {
                  "value": 1,
                  "label": "Economy"
                },
                {
                  "value": 2,
                  "label": "Business"
                }
              ]
            }
          ],
          "formula": "passengers * distance_km * (1 + is_return) * IF(distance_km <= 3700, factor(\"flight_short_economy\"), IF(cabin_class = 2, factor(\"flight_long_business\"), factor(\"flight_long_economy\")))",
