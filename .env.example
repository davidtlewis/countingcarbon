# Copy to .env and fill in values. Never commit .env.
#
# Local development (uv run python manage.py runserver) uses settings.dev and
# only needs SECRET_KEY, optionally DATABASE_URL. The rest is for the Docker
# stack (compose.yaml), which runs settings.prod.

# --- Django ---
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Comma-separated public hostnames; CSRF_TRUSTED_ORIGINS is derived from these
ALLOWED_HOSTS=countingcarbon.dtlewis.com
# mandatory | optional | none
ACCOUNT_EMAIL_VERIFICATION=mandatory

# --- Postgres (compose builds DATABASE_URL from this) ---
# Use URL-safe characters only: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# --- Email (SMTP, port 587 STARTTLS) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@countingcarbon.dtlewis.com

# --- Port publishing (compose.yaml) ---
# LAN IP of the app VM; the edge nginx host proxies to WEB_BIND_IP:WEB_PORT
WEB_BIND_IP=127.0.0.1
WEB_PORT=8001
